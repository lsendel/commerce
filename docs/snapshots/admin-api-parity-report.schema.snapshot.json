{
  "type": "object",
  "required": [
    "checks",
    "error",
    "finishedAt",
    "flakyPolicy",
    "metrics",
    "mutationChecksEnabled",
    "startedAt",
    "status"
  ],
  "properties": {
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "method",
          "name",
          "ok",
          "owner",
          "path",
          "status",
          "tags"
        ],
        "optional": [
          "attempts",
          "durationMs",
          "note",
          "suppressed"
        ],
        "properties": {
          "attempts": {
            "type": "number"
          },
          "durationMs": {
            "type": "number"
          },
          "method": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "owner": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "status": {
            "type": "union",
            "anyOf": [
              {
                "type": "literal",
                "value": "contract"
              },
              {
                "type": "number"
              }
            ]
          },
          "suppressed": {
            "type": "boolean"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "error": {
      "type": "union",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ]
    },
    "finishedAt": {
      "type": "string"
    },
    "flakyPolicy": {
      "type": "object",
      "required": [
        "externalProviderDefault",
        "installIntegrationApp",
        "uninstallIntegrationApp",
        "verifyIntegrationApp"
      ],
      "properties": {
        "externalProviderDefault": {
          "type": "object",
          "required": [
            "maxAttempts",
            "retryDelayMs",
            "suppressFailures"
          ],
          "properties": {
            "maxAttempts": {
              "type": "number"
            },
            "retryDelayMs": {
              "type": "number"
            },
            "suppressFailures": {
              "type": "boolean"
            }
          }
        },
        "installIntegrationApp": {
          "type": "object",
          "required": [
            "maxAttempts",
            "retryDelayMs",
            "suppressFailures"
          ],
          "properties": {
            "maxAttempts": {
              "type": "number"
            },
            "retryDelayMs": {
              "type": "number"
            },
            "suppressFailures": {
              "type": "boolean"
            }
          }
        },
        "uninstallIntegrationApp": {
          "type": "object",
          "required": [
            "maxAttempts",
            "retryDelayMs",
            "suppressFailures"
          ],
          "properties": {
            "maxAttempts": {
              "type": "number"
            },
            "retryDelayMs": {
              "type": "number"
            },
            "suppressFailures": {
              "type": "boolean"
            }
          }
        },
        "verifyIntegrationApp": {
          "type": "object",
          "required": [
            "maxAttempts",
            "retryDelayMs",
            "suppressFailures"
          ],
          "properties": {
            "maxAttempts": {
              "type": "number"
            },
            "retryDelayMs": {
              "type": "number"
            },
            "suppressFailures": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "failedChecks",
        "latencyMs",
        "ownerLatencyRollups",
        "ownerLatencySlo",
        "ownerRollups",
        "suppressedChecks",
        "tagRollups",
        "totalChecks"
      ],
      "properties": {
        "failedChecks": {
          "type": "number"
        },
        "latencyMs": {
          "type": "object",
          "required": [
            "avg",
            "count",
            "max",
            "min",
            "p50",
            "p95"
