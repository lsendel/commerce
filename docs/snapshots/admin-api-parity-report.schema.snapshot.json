          "properties": {
            "configuredOwners": {
              "type": "number"
            },
            "failures": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "owner",
                  "p95Ms",
                  "thresholdMs"
                ],
                "properties": {
                  "owner": {
                    "type": "string"
                  },
                  "p95Ms": {
                    "type": "number"
                  },
                  "thresholdMs": {
                    "type": "number"
                  }
                }
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "owner",
                  "p95Ms",
                  "thresholdMs"
                ],
                "properties": {
                  "owner": {
                    "type": "string"
                  },
                  "p95Ms": {
                    "type": "number"
                  },
                  "thresholdMs": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "ownerRollups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "failed",
              "key",
              "passed",
              "suppressed",
              "total"
            ],
            "properties": {
              "failed": {
                "type": "number"
              },
              "key": {
                "type": "string"
              },
              "passed": {
                "type": "number"
              },
              "suppressed": {
                "type": "number"
              },
              "total": {
                "type": "number"
              }
            }
          }
        },
        "suppressedChecks": {
          "type": "number"
        },
        "tagRollups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "failed",
              "key",
              "passed",
              "suppressed",
              "total"
            ],
            "properties": {
              "failed": {
                "type": "number"
              },
              "key": {
                "type": "string"
              },
              "passed": {
                "type": "number"
              },
              "suppressed": {
                "type": "number"
              },
              "total": {
                "type": "number"
              }
            }
          }
        },
        "totalChecks": {
          "type": "number"
        }
      }
    },
    "mutationChecksEnabled": {
      "type": "boolean"
    },
    "startedAt": {
      "type": "string"
    },
    "status": {
      "type": "union",
      "anyOf": [
        {
          "type": "literal",
          "value": "contract_only"
        },
        {
          "type": "literal",
          "value": "failed"
        },
        {
          "type": "literal",
          "value": "passed_with_suppressed"
        },
        {
          "type": "literal",
          "value": "passed"
        }
      ]
    }
  }
}
