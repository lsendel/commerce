{
  "version": "v1",
  "rules": [
    {
      "id": "runtime-auth-core",
      "surface": "runtime_env",
      "matchType": "exact",
      "matchValue": "JWT_SECRET",
      "sensitivity": "secret",
      "owner": "commerce-platform",
      "runbookPath": "docs/runbooks/secrets-rotation-hygiene.md",
      "rotation": {
        "cadenceDays": 45,
        "lastRotatedOn": "2026-02-20",
        "nextRotationBy": "2026-04-06"
      },
      "notes": "JWT signing key for customer/admin session tokens."
    },
    {
      "id": "runtime-audit-log-secret",
      "surface": "runtime_env",
      "matchType": "exact",
      "matchValue": "AUDIT_LOG_SECRET",
      "sensitivity": "secret",
      "owner": "commerce-security",
      "runbookPath": "docs/runbooks/secrets-rotation-hygiene.md",
      "rotation": {
        "cadenceDays": 45,
        "lastRotatedOn": "2026-02-20",
        "nextRotationBy": "2026-04-06"
      },
      "notes": "Audit trail integrity hash salt/secret."
    },
    {
      "id": "runtime-oauth-client-secrets",
      "surface": "runtime_env",
      "matchType": "regex",
      "matchValue": "^(GOOGLE|APPLE|META)_CLIENT_SECRET$",
      "sensitivity": "secret",
      "owner": "commerce-identity",
      "runbookPath": "docs/runbooks/secrets-rotation-hygiene.md",
      "rotation": {
        "cadenceDays": 90,
        "lastRotatedOn": "2026-01-10",
        "nextRotationBy": "2026-04-10"
      },
      "notes": "OAuth provider application secrets."
    },
    {
      "id": "runtime-stripe-credentials",
      "surface": "runtime_env",
      "matchType": "regex",
      "matchValue": "^STRIPE_(SECRET_KEY|WEBHOOK_SECRET|PUBLISHABLE_KEY)$",
      "sensitivity": "credential",
      "owner": "commerce-billing",
      "runbookPath": "docs/runbooks/secrets-rotation-hygiene.md",
      "rotation": {
        "cadenceDays": 60,
        "lastRotatedOn": "2026-02-12",
        "nextRotationBy": "2026-04-13"
      },
      "notes": "Stripe API, webhook, and publishable credentials rotated as a set."
    },
    {
      "id": "runtime-printful-credentials",
      "surface": "runtime_env",
      "matchType": "regex",
      "matchValue": "^PRINTFUL_(API_KEY|WEBHOOK_SECRET)$",
      "sensitivity": "secret",
      "owner": "commerce-operations",
      "runbookPath": "docs/runbooks/secrets-rotation-hygiene.md",
      "rotation": {
        "cadenceDays": 60,
        "lastRotatedOn": "2026-02-05",
        "nextRotationBy": "2026-04-06"
      },
      "notes": "Print provider sync and webhook credentials."
    },
    {
      "id": "runtime-prodigi-webhook",
      "surface": "runtime_env",
      "matchType": "exact",
      "matchValue": "PRODIGI_WEBHOOK_SECRET",
      "sensitivity": "secret",
      "owner": "commerce-operations",
      "runbookPath": "docs/runbooks/secrets-rotation-hygiene.md",
      "rotation": {
        "cadenceDays": 90,
        "lastRotatedOn": "2026-01-20",
        "nextRotationBy": "2026-04-20"
      },
      "notes": "Optional Prodigi webhook signature secret."
    },
    {
      "id": "runtime-ai-provider-keys",
      "surface": "runtime_env",
      "matchType": "exact",
      "matchValue": "GEMINI_API_KEY",
      "sensitivity": "secret",
      "owner": "commerce-ai",
      "runbookPath": "docs/runbooks/secrets-rotation-hygiene.md",
      "rotation": {
        "cadenceDays": 45,
        "lastRotatedOn": "2026-02-15",
        "nextRotationBy": "2026-04-01"
      },
      "notes": "AI provider API key used for assistant/copilot flows."
    },
    {
      "id": "runtime-notification-credentials",
      "surface": "runtime_env",
      "matchType": "regex",
      "matchValue": "^(RESEND_API_KEY|TWILIO_AUTH_TOKEN)$",
      "sensitivity": "secret",
      "owner": "commerce-comms",
      "runbookPath": "docs/runbooks/secrets-rotation-hygiene.md",
      "rotation": {
        "cadenceDays": 60,
        "lastRotatedOn": "2026-02-10",
        "nextRotationBy": "2026-04-11"
      },
      "notes": "Email and messaging provider credentials."
    },
    {
      "id": "runtime-encryption-key",
      "surface": "runtime_env",
      "matchType": "exact",
      "matchValue": "ENCRYPTION_KEY",
      "sensitivity": "secret",
      "owner": "commerce-security",
      "runbookPath": "docs/runbooks/secrets-rotation-hygiene.md",
      "rotation": {
        "cadenceDays": 45,
        "lastRotatedOn": "2026-02-22",
        "nextRotationBy": "2026-04-08"
      },
      "notes": "Envelope encryption key for stored integration secrets."
    },
    {
      "id": "runtime-cache-webhook-secret",
      "surface": "runtime_env",
      "matchType": "exact",
      "matchValue": "CACHE_WEBHOOK_SECRET",
      "sensitivity": "secret",
      "owner": "commerce-platform",
      "runbookPath": "docs/runbooks/secrets-rotation-hygiene.md",
      "rotation": {
        "cadenceDays": 90,
        "lastRotatedOn": "2026-01-25",
        "nextRotationBy": "2026-04-25"
      },
      "notes": "Cache purge webhook authentication secret."
    },
    {
      "id": "ci-cloudflare-secrets",
      "surface": "github_actions_secret",
      "matchType": "regex",
      "matchValue": "^CLOUDFLARE_(API_TOKEN|ACCOUNT_ID)$",
      "sensitivity": "secret",
      "owner": "commerce-platform",
      "runbookPath": "docs/runbooks/secrets-rotation-hygiene.md",
      "rotation": {
        "cadenceDays": 60,
        "lastRotatedOn": "2026-02-18",
        "nextRotationBy": "2026-04-19"
      },
      "notes": "CI deploy credentials for Cloudflare Worker deployment."
    },
    {
      "id": "ci-smoke-secrets",
      "surface": "github_actions_secret",
      "matchType": "prefix",
      "matchValue": "SMOKE_",
      "sensitivity": "credential",
      "owner": "commerce-sre",
      "runbookPath": "docs/runbooks/secrets-rotation-hygiene.md",
      "rotation": {
        "cadenceDays": 30,
        "lastRotatedOn": "2026-02-24",
        "nextRotationBy": "2026-03-26"
      },
      "notes": "Smoke-test tokens, auth headers, routing payloads, and alert webhooks."
    },
    {
      "id": "ci-claude-oauth",
      "surface": "github_actions_secret",
      "matchType": "exact",
      "matchValue": "CLAUDE_CODE_OAUTH_TOKEN",
      "sensitivity": "secret",
      "owner": "commerce-devex",
      "runbookPath": "docs/runbooks/secrets-rotation-hygiene.md",
      "rotation": {
        "cadenceDays": 90,
        "lastRotatedOn": "2026-02-01",
        "nextRotationBy": "2026-05-02"
      },
      "notes": "Automation OAuth token for Claude workflow integrations."
    }
  ]
}
