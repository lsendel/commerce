          "properties": {
            "avg": {
              "type": "union",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "count": {
              "type": "number"
            },
            "max": {
              "type": "union",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "min": {
              "type": "union",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "p50": {
              "type": "union",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "p95": {
              "type": "union",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            }
          }
        },
        "ownerLatencyRollups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "checkCount",
              "latencyMs",
              "owner"
            ],
            "properties": {
              "checkCount": {
                "type": "number"
              },
              "latencyMs": {
                "type": "object",
                "required": [
                  "avg",
                  "count",
                  "max",
                  "min",
                  "p50",
                  "p95"
                ],
                "properties": {
                  "avg": {
                    "type": "union",
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "count": {
                    "type": "number"
                  },
                  "max": {
                    "type": "union",
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "min": {
                    "type": "union",
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "p50": {
                    "type": "union",
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "p95": {
                    "type": "union",
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  }
                }
              },
              "owner": {
                "type": "string"
              }
            }
          }
        },
        "ownerLatencySlo": {
          "type": "object",
          "required": [
            "configuredOwners",
            "failures",
            "warnings"
